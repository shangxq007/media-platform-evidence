+it('V5 history stores only local titles/positions and restores onto current identity and camera', () => {
+  const initial = createCanvasState('p')
+  const changed = renameCanvasNode(moveCanvasGroup(initial, initial.nodes, { x: 12, y: -8 }), 'note-node', 'Draft')
+  const history = recordCanvasEdit(emptyCanvasHistory(), initial, changed)
+  expect(history.undo).toHaveLength(1)
+  for (const values of [history.undo[0].before, history.undo[0].after]) {
+    values.forEach(value => expect(Object.keys(value).sort()).toEqual(['presentationId', 'title', 'x', 'y']))
+  }
+  const current = { ...changeZoom(moveViewport(changed, 71, -31), 0.5), references: [{ ...initial.references[0], entityId: 'current-identity' }], edges: [] }
+  const restored = restoreCanvasEdit(current, history.undo[0].before)
+  expect(restored.nodes.map(({ title, x, y }) => ({ title, x, y }))).toEqual(initial.nodes.map(({ title, x, y }) => ({ title, x, y })))
+  expect(restored.references).toBe(current.references)
+  expect(restored.edges).toBe(current.edges)
+  expect(restored.nodes.map(node => [node.presentationId, node.semanticReferenceId])).toEqual(current.nodes.map(node => [node.presentationId, node.semanticReferenceId]))
+  expect([restored.zoom, restored.viewportX, restored.viewportY]).toEqual([1.5, 71, -31])
+  expect(recordCanvasEdit(history, changed, current)).toBe(history)
+})
