diff --git a/frontend/src/product/render-browser/render-browser.css b/frontend/src/product/render-browser/render-browser.css
new file mode 100644
index 0000000000000000000000000000000000000000..994266888bc05a01c6f37ea61f65aac9083187ca
--- /dev/null
+++ b/frontend/src/product/render-browser/render-browser.css
@@ -0,0 +1,32 @@
+.ff-render-browser { display: grid; gap: var(--space-4); min-width: 0; }
+.ff-render-browser-heading { display: flex; align-items: start; justify-content: space-between; gap: var(--space-4); }
+.ff-render-browser-heading h1 { margin: .25rem 0; }
+.ff-render-browser-heading p { max-width: 70ch; }
+.ff-render-origin { margin: 0; }
+.ff-render-scope { max-width: 38rem; }
+.ff-render-scope dl { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: .5rem 1rem; }
+.ff-render-scope dd { margin: 0; min-width: 0; overflow-wrap: anywhere; }
+.ff-render-boundary, .ff-render-receipt { color: var(--text-secondary); }
+.ff-render-controls { display: grid; grid-template-columns: minmax(12rem, 1fr) minmax(10rem, auto) minmax(10rem, auto) auto; gap: var(--space-3); align-items: end; }
+.ff-render-controls label { display: grid; gap: .35rem; }
+.ff-render-controls select { min-height: 2.5rem; max-width: 100%; }
+.ff-render-list-scroll { max-height: 34rem; overflow: auto; overscroll-behavior: contain; padding-inline-end: .25rem; }
+.ff-render-browser-list { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr)); gap: var(--space-3); list-style: none; margin: 0; padding: 0; }
+.ff-render-browser-list .ff-panel__body { display: grid; gap: .65rem; align-items: start; }
+.ff-render-browser-list code, .ff-render-detail code { overflow-wrap: anywhere; }
+.ff-render-detail { width: min(58rem, calc(100vw - 2rem)); max-height: min(48rem, calc(100vh - 2rem)); overflow: auto; }
+.ff-render-detail-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .25rem 1rem; }
+.ff-render-detail-section { border-top: 1px solid var(--border-default); margin-top: var(--space-4); padding-top: var(--space-3); }
+.ff-render-detail-section h3, .ff-render-detail-section h4 { margin-block: .4rem .75rem; }
+.ff-render-attempts, .ff-render-artifacts { display: grid; gap: var(--space-3); padding-inline-start: 1.25rem; }
+.ff-render-attempts > li, .ff-render-artifacts > li { min-width: 0; padding: var(--space-3); border: 1px solid var(--border-default); border-radius: var(--radius-md); }
+.ff-render-artifacts > li > div:first-child { display: flex; flex-wrap: wrap; gap: .5rem; justify-content: space-between; }
+.ff-render-readonly-limit { margin-top: var(--space-4); color: var(--text-secondary); }
+
+@media (max-width: 760px) {
+  .ff-render-browser-heading { align-items: stretch; flex-direction: column; }
+  .ff-render-controls { grid-template-columns: minmax(0, 1fr); }
+  .ff-render-controls select, .ff-render-controls .ff-button { width: 100%; }
+  .ff-render-detail-grid { grid-template-columns: minmax(0, 1fr); }
+  .ff-render-detail { width: calc(100vw - 1rem); }
+}
