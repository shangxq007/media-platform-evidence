+def receipt_summary(path: Path, document: dict) -> dict:
+    summary = {"raw_sha256": digest(path), "raw_size": path.stat().st_size}
+    for key in ("schema", "result", "run_id", "candidate", "tree", "base", "time"):
+        if key in document:
+            summary[key] = document[key]
+    return summary
+
